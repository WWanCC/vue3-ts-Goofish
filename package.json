{
  "name": "vue3-ts-goofish",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @goofish/web --filter @goofish/api run dev",
    "build": "pnpm --filter @goofish/web build",
    "preview": "pnpm --filter @goofish/web preview",
    "test:unit": "pnpm --filter @goofish/web test:unit",
    "type-check": "pnpm --filter @goofish/web type-check",
    "lint": "pnpm --filter @goofish/web lint",
    "format": "pnpm --filter @goofish/web format"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "devDependencies": {
    "wait-on": "^9.1.0"
  }
}
